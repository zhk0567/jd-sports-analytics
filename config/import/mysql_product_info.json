{
  "job": {
    "setting": {
      "speed": {
        "channel": 3
      }
    },
    "content": [
      {
        "reader": {
          "name": "txtfilereader",
          "parameter": {
            "path": [
              "./data/ods_csv/product_info.csv"
            ],
            "encoding": "UTF-8",
            "column": [
              "product_id",
              "product_name",
              "category_id",
              "brand_id",
              "shop_id",
              "price",
              "original_price",
              "stock_qty",
              "sales_qty",
              "size",
              "color",
              "material",
              "target_group",
              "season",
              "listing_date",
              "status",
              "image_url"
            ],
            "fieldDelimiter": ",",
            "skipHeader": true
          }
        },
        "writer": {
          "name": "mysqlwriter",
          "parameter": {
            "writeMode": "replace",
            "username": "root",
            "password": "root",
            "column": [
              "product_id",
              "product_name",
              "category_id",
              "brand_id",
              "shop_id",
              "price",
              "original_price",
              "stock_qty",
              "sales_qty",
              "size",
              "color",
              "material",
              "target_group",
              "season",
              "listing_date",
              "status",
              "image_url"
            ],
            "connection": [
              {
                "jdbcUrl": "jdbc:mysql://127.0.0.1:3306/t2_ecommerce_ods?useUnicode=true&characterEncoding=utf8",
                "table": [
                  "t2_ods_product_info"
                ]
              }
            ]
          }
        }
      }
    ]
  }
}