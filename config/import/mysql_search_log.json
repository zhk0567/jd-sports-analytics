{
  "job": {
    "setting": {
      "speed": {
        "channel": 3
      }
    },
    "content": [
      {
        "reader": {
          "name": "txtfilereader",
          "parameter": {
            "path": [
              "./data/ods_csv/search_log.csv"
            ],
            "encoding": "UTF-8",
            "column": [
              "log_id",
              "user_id",
              "search_time",
              "keyword",
              "scene",
              "result_count",
              "click_count",
              "duration_sec",
              "device",
              "session_id"
            ],
            "fieldDelimiter": ",",
            "skipHeader": true
          }
        },
        "writer": {
          "name": "mysqlwriter",
          "parameter": {
            "writeMode": "replace",
            "username": "root",
            "password": "root",
            "column": [
              "log_id",
              "user_id",
              "search_time",
              "keyword",
              "scene",
              "result_count",
              "click_count",
              "duration_sec",
              "device",
              "session_id"
            ],
            "connection": [
              {
                "jdbcUrl": "jdbc:mysql://127.0.0.1:3306/t2_ecommerce_ods?useUnicode=true&characterEncoding=utf8",
                "table": [
                  "t2_ods_search_log"
                ]
              }
            ]
          }
        }
      }
    ]
  }
}