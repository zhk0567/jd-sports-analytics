{
  "job": {
    "setting": {
      "speed": {
        "channel": 3
      }
    },
    "content": [
      {
        "reader": {
          "name": "txtfilereader",
          "parameter": {
            "path": [
              "./data/ods_csv/order_info.csv"
            ],
            "encoding": "UTF-8",
            "column": [
              "order_id",
              "user_id",
              "order_time",
              "order_status",
              "total_amount",
              "discount_amount",
              "shipping_fee",
              "pay_amount",
              "province",
              "city",
              "channel",
              "promo_id",
              "coupon_amount",
              "order_date"
            ],
            "fieldDelimiter": ",",
            "skipHeader": true
          }
        },
        "writer": {
          "name": "mysqlwriter",
          "parameter": {
            "writeMode": "replace",
            "username": "root",
            "password": "root",
            "column": [
              "order_id",
              "user_id",
              "order_time",
              "order_status",
              "total_amount",
              "discount_amount",
              "shipping_fee",
              "pay_amount",
              "province",
              "city",
              "channel",
              "promo_id",
              "coupon_amount",
              "order_date"
            ],
            "connection": [
              {
                "jdbcUrl": "jdbc:mysql://127.0.0.1:3306/t2_ecommerce_ods?useUnicode=true&characterEncoding=utf8",
                "table": [
                  "t2_ods_order_info"
                ]
              }
            ]
          }
        }
      }
    ]
  }
}