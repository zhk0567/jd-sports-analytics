{
  "job": {
    "setting": {
      "speed": {
        "channel": 3
      }
    },
    "content": [
      {
        "reader": {
          "name": "txtfilereader",
          "parameter": {
            "path": [
              "./data/ods_csv/shop_info.csv"
            ],
            "encoding": "UTF-8",
            "column": [
              "shop_id",
              "shop_name",
              "shop_type",
              "province",
              "city",
              "rating",
              "open_date"
            ],
            "fieldDelimiter": ",",
            "skipHeader": true
          }
        },
        "writer": {
          "name": "hdfswriter",
          "parameter": {
            "defaultFS": "hdfs://localhost:9000",
            "fileType": "text",
            "path": "/user/hive/warehouse/t2_ecommerce.db/t2_ods_shop_info",
            "fileName": "shop_info.csv",
            "writeMode": "append",
            "fieldDelimiter": ",",
            "column": [
              {
                "name": "shop_id",
                "type": "string"
              },
              {
                "name": "shop_name",
                "type": "string"
              },
              {
                "name": "shop_type",
                "type": "string"
              },
              {
                "name": "province",
                "type": "string"
              },
              {
                "name": "city",
                "type": "string"
              },
              {
                "name": "rating",
                "type": "string"
              },
              {
                "name": "open_date",
                "type": "string"
              }
            ]
          }
        }
      }
    ]
  }
}