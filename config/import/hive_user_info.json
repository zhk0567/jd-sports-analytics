{
  "job": {
    "setting": {
      "speed": {
        "channel": 3
      }
    },
    "content": [
      {
        "reader": {
          "name": "txtfilereader",
          "parameter": {
            "path": [
              "./data/ods_csv/user_info.csv"
            ],
            "encoding": "UTF-8",
            "column": [
              "user_id",
              "username",
              "gender",
              "age",
              "phone",
              "email",
              "province",
              "city",
              "register_time",
              "user_level",
              "is_member",
              "last_login_time"
            ],
            "fieldDelimiter": ",",
            "skipHeader": true
          }
        },
        "writer": {
          "name": "hdfswriter",
          "parameter": {
            "defaultFS": "hdfs://localhost:9000",
            "fileType": "text",
            "path": "/user/hive/warehouse/t2_ecommerce.db/t2_ods_user_info",
            "fileName": "user_info.csv",
            "writeMode": "append",
            "fieldDelimiter": ",",
            "column": [
              {
                "name": "user_id",
                "type": "string"
              },
              {
                "name": "username",
                "type": "string"
              },
              {
                "name": "gender",
                "type": "string"
              },
              {
                "name": "age",
                "type": "string"
              },
              {
                "name": "phone",
                "type": "string"
              },
              {
                "name": "email",
                "type": "string"
              },
              {
                "name": "province",
                "type": "string"
              },
              {
                "name": "city",
                "type": "string"
              },
              {
                "name": "register_time",
                "type": "string"
              },
              {
                "name": "user_level",
                "type": "string"
              },
              {
                "name": "is_member",
                "type": "string"
              },
              {
                "name": "last_login_time",
                "type": "string"
              }
            ]
          }
        }
      }
    ]
  }
}